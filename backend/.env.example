# Copy to backend/.env and fill in. Never commit backend/.env.

# Tiger Data. The default matches docker-compose.yml; swap in the Tiger Cloud URL for the deployed app.
# Leave empty to run the API on mock data with no database at all.
DATABASE_URL=postgresql://oddsmaker:oddsmaker@localhost:5432/oddsmaker

# Required to call POST /api/markets/:id/resolve (sent as the X-Host-Password header).
HOST_PASSWORD=change-me

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Scout. With both keys set, host setup reads a pasted event page for real (one Nimble extract and
# one Gemini call per read), whether or not SCOUT_ENABLED is on. Without them it shows sample details.
NIMBLE_API_KEY=
GEMINI_API_KEY=
# Confirm the current model id in the Gemini docs before relying on this.
GEMINI_MODEL=gemini-3.8-flash
# Optional; raises the GitHub API rate limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
# The hackathon's event page, read once to learn the prize criteria.
EVENT_URL=
# Turn on Scout's report at team sign-up and its timed refresh. Off by default so local runs don't spend Nimble credits.
# SCOUT_INTERVAL_MINUTES=0 keeps Scout on but stops the timer, to save Gemini quota: teams then
# get a report at sign-up and when someone presses Run Scout on their report (at most once
# every 10 minutes per team).
SCOUT_ENABLED=false
SCOUT_INTERVAL_MINUTES=30
