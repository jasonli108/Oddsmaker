# Optional. Leave unset in dev: Vite proxies /api to http://localhost:8000.
# Set for a deployed build when the API lives on another origin (no trailing slash).
# VITE_API_BASE_URL=https://oddsmaker-api.example.com

# Optional. The address attendees use to reach the app, shown in the share link and QR code on
# the "Markets are live" screen. Defaults to wherever the page is being served from, which is
# http://localhost:5173 in dev. Set it when you run behind a tunnel or deploy (no trailing slash).
# VITE_PUBLIC_URL=https://oddsmaker.example.com
